# Copy to .env and fill in. Never commit the real .env.

# Public address of the shop (used in emails and payment redirects)
PUBLIC_URL=http://localhost:5173
PORT=4000

# Long random string (at least 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Where the database and uploaded images live (keep it on a persistent disk / volume)
DATA_DIR=data

# First admin account, created automatically on first start if no admin exists
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (SMTP). Without these, emails are only logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="My Shop <orders@myshop.gr>"

# Card payments via Stripe (optional). Webhook endpoint: https://<domain>/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
