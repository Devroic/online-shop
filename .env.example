# Local development (npm run dev): copy this file to .env
#
# Nothing is required: without values the shop uses an embedded database and a
# local image folder (data/), emails are printed to the terminal and card
# payments are hidden. Fill in only what you want to try.
#
# Do NOT use this file for clients: see the template in docs/NEW_CLIENT.md
# (.env.<client> + Environment Variables in Vercel).
# Careful: with a client's DATABASE_URL here, npm run dev works on their LIVE shop.

PUBLIC_URL=http://localhost:5173

# Empty = a development-only key is used
JWT_SECRET=

# --- Supabase (optional) -------------------------------------------------------------
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (optional) ---------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=

# --- Stripe (optional, test keys sk_test_… only) -------------------------------------
# Webhooks locally: stripe listen --forward-to localhost:4000/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
