# Τοπική ανάπτυξη (npm run dev): αντέγραψε το αρχείο σε .env
#
# ΔΕΝ χρειάζεται να συμπληρώσεις τίποτα: χωρίς τιμές το κατάστημα χρησιμοποιεί
# ενσωματωμένη βάση και τοπικό φάκελο φωτογραφιών (data/), τα email απλώς
# γράφονται στο terminal και η πληρωμή με κάρτα δεν εμφανίζεται.
# Συμπλήρωσε μόνο ό,τι θέλεις να δοκιμάσεις.
#
# Για τους πελάτες ΜΗΝ χρησιμοποιείς αυτό το αρχείο: δες το template στο
# docs/NEW_CLIENT.md (.env.<πελάτης> + Environment Variables στο Vercel).
# Προσοχή: αν βάλεις εδώ το DATABASE_URL ενός πελάτη, το npm run dev δουλεύει
# πάνω στο ΖΩΝΤΑΝΟ κατάστημά του.

PUBLIC_URL=http://localhost:5173

# Κενό = χρησιμοποιείται κλειδί ανάπτυξης (μόνο τοπικά)
JWT_SECRET=

# --- Supabase (προαιρετικό) --------------------------------------------------------
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (προαιρετικό) ------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=

# --- Stripe (προαιρετικό, μόνο test κλειδιά sk_test_…) -------------------------------
# Για webhooks τοπικά: stripe listen --forward-to localhost:4000/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
