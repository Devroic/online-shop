# Copy to .env for local development. On Vercel, add the same variables in
# Project → Settings → Environment Variables (one Vercel project per client).
# Leave DATABASE_URL / SUPABASE_* empty locally to use the built-in database
# and local image folder — nothing to install.

# Public address of the shop (used in emails, payment and sign-in redirects)
PUBLIC_URL=http://localhost:5173

# Long random string (at least 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Supabase (Project Settings → API / Database) -------------------------
# Database: "Connection pooling" → Transaction mode (port 6543)
DATABASE_URL=
SUPABASE_URL=
# Public key, used in the browser only for Google/Apple sign-in
SUPABASE_ANON_KEY=
# Secret key, server only (image uploads). Never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=shop

# --- Email -------------------------------------------------------------------
# Resend (recommended): https://resend.com → API Keys. The domain in MAIL_FROM must be verified there.
RESEND_API_KEY=
MAIL_FROM="My Shop <orders@myshop.gr>"
# …or SMTP instead of Resend
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Card payments (Stripe, optional) ------------------------------------------
# Webhook endpoint: https://<domain>/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Optional --------------------------------------------------------------------
# First admin, created automatically if the shop has none
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Time zone for "today" and daily charts in the dashboard
SHOP_TIMEZONE=Europe/Athens
