{
  "name": "online-shop-template",
  "version": "1.0.0",
  "private": true,
  "description": "Online shop template: React storefront + admin, Node/Express API, SQLite.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "configure": "npm run configure -w server --",
    "create-admin": "npm run create-admin -w server --",
    "test": "npm test -w server",
    "lint": "npm run lint -w client"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "engines": {
    "node": ">=20"
  }
}
