{
  "name": "online-shop-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Online shop template: React storefront + admin, Node/Express API, PostgreSQL (Supabase). Deploys to Vercel.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server --",
    "configure": "npm run configure -w server --",
    "create-admin": "npm run create-admin -w server --",
    "test": "npm test -w server",
    "questionnaire": "node scripts/questionnaire/build.mjs"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "concurrently": "^10.0.6",
    "pdf-lib": "^1.17.1"
  },
  "engines": {
    "node": ">=20"
  }
}
